    "b-pp-intro": {
      "id": "b-pp-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The dashboard "
        },
        {
          "insert": "Agents",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " page shows a sample prompt for each agent in "
        },
        {
          "insert": "KERNEL_AGENT_IDS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The server renders each sample with the real prompt builders and returns it from "
        },
        {
          "insert": "GET /api/kernel/agents",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A prompt change must update this preview path in the same change, so the page shows what the agent gets."
        }
      ],
      "children": []
    },
